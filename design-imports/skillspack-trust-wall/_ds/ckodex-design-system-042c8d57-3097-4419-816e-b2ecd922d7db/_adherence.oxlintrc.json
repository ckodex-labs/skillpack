{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "dotbg.js",
              "redesign-v2/**",
              "ui_kits/governance-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono|Geist|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono, Geist, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet|ghost|emergency)$/]",
        "message": "<Button> variant must be one of 'primary' | 'quiet' | 'ghost' | 'emergency'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceHash'] > JSXAttribute > JSXIdentifier[name!=/^(?:digest|label|onInspect|key|ref|className|style|children)$/]",
        "message": "<EvidenceHash> doesn't accept that prop. Declared props: digest, label, onInspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceReceipt'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|event|details|kind|key|ref|className|style|children)$/]",
        "message": "<EvidenceReceipt> doesn't accept that prop. Declared props: time, event, details, kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceReceipt'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:routine|proof|alarm)$/]",
        "message": "<EvidenceReceipt> kind must be one of 'routine' | 'proof' | 'alarm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|brand|crumb|urn|headerRight|nav|margin|footerLeft|footerRight|children|key|ref|className|style|children)$/]",
        "message": "<PageShell> doesn't accept that prop. Declared props: variant, brand, crumb, urn, headerRight, nav, margin, footerLeft, footerRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageShell'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:console|document|reading)$/]",
        "message": "<PageShell> variant must be one of 'console' | 'document' | 'reading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:digest|verb|key|ref|className|style|children)$/]",
        "message": "<ProvenanceStamp> doesn't accept that prop. Declared props: digest, verb."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceStamp'] > JSXAttribute[name.name='verb'] > Literal[value!=/^(?:sealed|attested|exported|signed)$/]",
        "message": "<ProvenanceStamp> verb must be one of 'sealed' | 'attested' | 'exported' | 'signed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuietCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:sealed|children|key|ref|className|style|children)$/]",
        "message": "<QuietCard> doesn't accept that prop. Declared props: sealed, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|glyph|children|key|ref|className|style|children)$/]",
        "message": "<StateChip> doesn't accept that prop. Declared props: state, glyph, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:observed|inferred|claimed|attested|contradicted|quarantined)$/]",
        "message": "<StateChip> state must be one of 'observed' | 'inferred' | 'claimed' | 'attested' | 'contradicted' | 'quarantined'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
