{
    "$id": "https://schemas.ckodex.org/prove/v1/policy.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Prove Policy Bundle v1",
    "type": "object",
    "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
    ],
    "properties": {
        "apiVersion": {
            "type": "string",
            "const": "prove.ckodex.org/v1"
        },
        "kind": {
            "type": "string",
            "const": "PolicyBundle"
        },
        "metadata": {
            "$ref": "https://schemas.ckodex.org/common/types.schema.json#/$defs/ResourceMetadata"
        },
        "spec": {
            "type": "object",
            "required": [
                "targets",
                "enforcements"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/Target"
                    }
                },
                "enforcements": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/Enforcement"
                    }
                },
                "engines": {
                    "type": "array",
                    "description": "Optional links to external policy engines/bundles (OPA, Cedar, etc.).",
                    "items": {
                        "$ref": "#/$defs/EngineBinding"
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "$defs": {
        "Target": {
            "title": "Target",
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Target identifier referenced from enforcements."
                },
                "kinds": {
                    "type": "array",
                    "description": "Subject kinds to which this target applies (e.g. 'Model', 'SkillBundle', 'AgentApp', 'Run').",
                    "items": {
                        "type": "string"
                    }
                },
                "urnPatterns": {
                    "type": "array",
                    "description": "Simple glob-style patterns for URNs (e.g. 'urn:ckodex:model:*').",
                    "items": {
                        "type": "string"
                    }
                },
                "operations": {
                    "type": "array",
                    "description": "Operations to which this target applies (e.g. 'build', 'deploy', 'execute', 'promote', 'quarantine').",
                    "items": {
                        "type": "string"
                    }
                },
                "labels": {
                    "$ref": "https://schemas.ckodex.org/common/types.schema.json#/$defs/LabelMap"
                }
            },
            "additionalProperties": false
        },
        "Requirements": {
            "title": "Requirements",
            "type": "object",
            "properties": {
                "minGal": {
                    "$ref": "https://schemas.ckodex.org/common/types.schema.json#/$defs/GAL"
                },
                "maxGal": {
                    "$ref": "https://schemas.ckodex.org/common/types.schema.json#/$defs/GAL"
                },
                "requiredAsc": {
                    "type": "array",
                    "items": {
                        "$ref": "https://schemas.ckodex.org/common/types.schema.json#/$defs/ASC"
                    }
                },
                "requiredEvidenceTypes": {
                    "type": "array",
                    "description": "Logical evidence statement types required before allowing the operation (e.g. 'BuildProvenance', 'RiskAssessment').",
                    "items": {
                        "type": "string"
                    }
                },
                "requireHumanApproval": {
                    "type": "boolean",
                    "default": false
                },
                "approverRoles": {
                    "type": "array",
                    "description": "Roles allowed to approve when requireHumanApproval=true.",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "Enforcement": {
            "title": "Enforcement",
            "type": "object",
            "required": [
                "id",
                "targetRefs",
                "effect"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable identifier for this enforcement rule."
                },
                "description": {
                    "type": "string"
                },
                "targetRefs": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Names of targets this enforcement attaches to.",
                    "items": {
                        "type": "string"
                    }
                },
                "effect": {
                    "type": "string",
                    "enum": [
                        "allow",
                        "deny",
                        "review"
                    ],
                    "description": "High-level effect; 'review' typically implies requireHumanApproval=true + evidence requirements."
                },
                "requirements": {
                    "$ref": "#/$defs/Requirements"
                }
            },
            "additionalProperties": false
        },
        "EngineBinding": {
            "title": "EngineBinding",
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Type of policy engine (e.g. 'opa', 'cedar', 'native', 'other')."
                },
                "bundleUrn": {
                    "$ref": "https://schemas.ckodex.org/common/types.schema.json#/$defs/Urn",
                    "description": "URN of the external policy code/bundle (e.g. OPA bundle)."
                },
                "entrypoints": {
                    "type": "array",
                    "description": "Entrypoints/queries in the external engine (e.g. OPA data paths).",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}