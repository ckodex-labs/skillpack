{
    "$id": "https://schemas.ckodex.org/cnsb/v1/skill-lock.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Skill Lock File v1",
    "description": "Pins exact dependency versions for reproducible skill installations",
    "type": "object",
    "required": ["lockVersion", "dependencies"],
    "properties": {
        "lockVersion": {
            "type": "integer",
            "const": 1,
            "description": "Lock file format version"
        },
        "metadata": {
            "type": "object",
            "properties": {
                "generated": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When this lock file was generated"
                },
                "generator": {
                    "type": "string",
                    "description": "Tool that generated this lock file (e.g. skillpack@1.0.0)"
                },
                "checksum": {
                    "type": "string",
                    "description": "SHA256 checksum of the resolved dependency tree"
                }
            }
        },
        "dependencies": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/LockedDependency"
            },
            "description": "Map of URN to locked dependency details"
        },
        "registries": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/Registry"
            },
            "description": "Registry configurations used for resolution"
        }
    },
    "$defs": {
        "LockedDependency": {
            "type": "object",
            "required": ["version", "resolved", "integrity"],
            "properties": {
                "version": {
                    "type": "string",
                    "description": "Resolved semantic version"
                },
                "resolved": {
                    "type": "string",
                    "description": "Full resolved reference (e.g. OCI digest)"
                },
                "integrity": {
                    "type": "string",
                    "pattern": "^sha(256|384|512)-[A-Za-z0-9+/=]+$",
                    "description": "Subresource Integrity hash (SRI format)"
                },
                "registry": {
                    "type": "string",
                    "description": "Registry where this dependency was resolved"
                },
                "signature": {
                    "type": "object",
                    "properties": {
                        "keyId": { "type": "string" },
                        "algorithm": { "type": "string" },
                        "value": { "type": "string" }
                    },
                    "description": "Sigstore/cosign signature if available"
                },
                "dependencies": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Transitive dependencies (URNs)"
                }
            }
        },
        "Registry": {
            "type": "object",
            "required": ["url"],
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Registry base URL"
                },
                "type": {
                    "type": "string",
                    "enum": ["oci", "npm", "git"],
                    "default": "oci"
                },
                "auth": {
                    "type": "string",
                    "enum": ["none", "token", "oidc"],
                    "default": "none"
                }
            }
        }
    },
    "additionalProperties": false
}
