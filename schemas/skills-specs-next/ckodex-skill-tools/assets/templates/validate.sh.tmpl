#!/usr/bin/env bash
# Bundle self-test for ${name}.
# Exits 0 on 0F/0W. Exits non-zero on any failure.
# This file was generated by ckodex-skill-tools v${tools_version}.

set -eu
cd "$$(dirname "$$0")/.."

PACK="${name}"
FAIL=0
WARN=0
SECTIONS=0

say()    { printf '%s\n' "$$*"; }
ok()     { say "  OK   $$*"; }
fail()   { say "  FAIL $$*"; FAIL=$$((FAIL+1)); }
warn()   { say "  WARN $$*"; WARN=$$((WARN+1)); }
section(){ SECTIONS=$$((SECTIONS+1)); say ""; say "§$${SECTIONS} $$*"; }

# ────────────────────────────────────────────────────────────────
section "Required files present"
for f in SKILL.md skill.json MANIFEST.json references/usage.md scripts/validate.sh; do
  if [ -f "$$f" ]; then ok "$$f"; else fail "$$f missing"; fi
done

# ────────────────────────────────────────────────────────────────
section "JSON parse"
for f in skill.json MANIFEST.json; do
  if python3 -c "import json; json.load(open('$$f'))" 2>/dev/null; then
    ok "$$f parses"
  else
    fail "$$f parse error"
  fi
done

# ────────────────────────────────────────────────────────────────
section "Manifest required fields"
python3 - <<'PY'
import json, sys
m = json.load(open("skill.json"))
fail = 0
def need(path, val):
    global fail
    if val is None or val == "":
        print(f"  FAIL {path}: missing or empty")
        fail += 1
    else:
        print(f"  OK   {path}")
need("apiVersion", m.get("apiVersion"))
need("kind", m.get("kind"))
need("metadata.name", m.get("metadata", {}).get("name"))
need("metadata.description", m.get("metadata", {}).get("description"))
need("entrypoints.skillMd", m.get("entrypoints", {}).get("skillMd"))
sys.exit(1 if fail else 0)
PY
if [ $$? -ne 0 ]; then FAIL=$$((FAIL+1)); fi

# ────────────────────────────────────────────────────────────────
section "SKILL.md frontmatter consistency"
python3 - <<'PY'
import json, re, sys
m = json.load(open("skill.json"))
md = open("SKILL.md", encoding="utf-8").read()
mt = re.match(r"^---\s*\n(.*?)\n---\s*\n", md, re.DOTALL)
fail = 0
if not mt:
    print("  FAIL SKILL.md has no YAML frontmatter")
    sys.exit(1)
fm = mt.group(1)
fm_name = next((l.split(":",1)[1].strip() for l in fm.splitlines() if l.startswith("name:")), None)
fm_desc = next((l.split(":",1)[1].strip() for l in fm.splitlines() if l.startswith("description:")), None)
js_name = m.get("metadata", {}).get("name")
js_desc = m.get("metadata", {}).get("description")
if fm_name != js_name:
    print(f"  FAIL frontmatter name {fm_name!r} != skill.json {js_name!r}")
    fail += 1
else:
    print(f"  OK   name matches: {fm_name}")
if fm_desc != js_desc:
    print(f"  FAIL frontmatter description differs from skill.json")
    fail += 1
else:
    print(f"  OK   description matches")
sys.exit(1 if fail else 0)
PY
if [ $$? -ne 0 ]; then FAIL=$$((FAIL+1)); fi

# ────────────────────────────────────────────────────────────────
section "Name regex + length limits"
python3 - <<'PY'
import json, re, sys
m = json.load(open("skill.json"))
name = m["metadata"]["name"]
desc = m["metadata"]["description"]
syn  = m["metadata"].get("synopsis", "")
fail = 0
if not re.match(r"^(?!-)(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$$", name) or len(name) > 64:
    print(f"  FAIL name {name!r} violates v1 regex or length")
    fail += 1
else:
    print(f"  OK   name regex + length")
if len(desc) < 1 or len(desc) > 1024:
    print(f"  FAIL description length {len(desc)} not in [1,1024]")
    fail += 1
else:
    print(f"  OK   description length {len(desc)}")
if syn and (len(syn) < 1 or len(syn) > 2048):
    print(f"  FAIL synopsis length {len(syn)} not in [1,2048]")
    fail += 1
elif syn:
    print(f"  OK   synopsis length {len(syn)}")
sys.exit(1 if fail else 0)
PY
if [ $$? -ne 0 ]; then FAIL=$$((FAIL+1)); fi

# ────────────────────────────────────────────────────────────────
section "Declared resources exist on disk"
python3 - <<'PY'
import json, os, sys
m = json.load(open("skill.json"))
res = m.get("resources", {})
fail = 0
for kind in ("scripts", "references", "assets"):
    for p in res.get(kind, []):
        if os.path.exists(p):
            print(f"  OK   {p}")
        else:
            print(f"  FAIL {p} declared but not on disk")
            fail += 1
sys.exit(1 if fail else 0)
PY
if [ $$? -ne 0 ]; then FAIL=$$((FAIL+1)); fi

# ────────────────────────────────────────────────────────────────
section "MANIFEST.json sha256 ledger"
python3 - <<'PY'
import hashlib, json, os, sys
m = json.load(open("MANIFEST.json"))
fail = 0
def skip(p): return "__pycache__" in p or p.endswith((".pyc",".pyo"))
for entry in m.get("files", []):
    path = entry["path"]
    if skip(path): continue
    expected = entry["sha256"]
    if not os.path.exists(path):
        print(f"  FAIL {path}: not on disk")
        fail += 1
        continue
    actual = "sha256:" + hashlib.sha256(open(path,'rb').read()).hexdigest()
    if actual != expected:
        print(f"  FAIL {path}: digest mismatch")
        fail += 1
    else:
        print(f"  OK   {path}")
sys.exit(1 if fail else 0)
PY
if [ $$? -ne 0 ]; then FAIL=$$((FAIL+1)); fi

# ────────────────────────────────────────────────────────────────
section "Summary"
say ""
say "Pack: $$PACK"
say "Sections run: $$SECTIONS"
say "Failures: $$FAIL"
say "Warnings: $$WARN"
say ""
if [ "$$FAIL" -eq 0 ] && [ "$$WARN" -eq 0 ]; then
  say "STATUS: 0F / 0W — PASS"
  exit 0
elif [ "$$FAIL" -eq 0 ]; then
  say "STATUS: 0F / $${WARN}W — PASS with warnings"
  exit 0
else
  say "STATUS: $${FAIL}F / $${WARN}W — FAIL"
  exit 1
fi
